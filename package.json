{
  "name": "quiz-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "agent:test": "node test-agent.js",
    "agent:server": "node server/solverServer.js",
    "test:parser:diagnose": "rolldown scripts/parser-diagnostics.ts -p node -f esm -o .npm-cache/parser-diagnostics.mjs && node .npm-cache/parser-diagnostics.mjs",
    "test:parser": "rolldown tests/textQuestionParser.test.ts -p node -f esm -o .npm-cache/parser-test.mjs && node .npm-cache/parser-test.mjs",
    "test:solver": "node tests/solveMissingQuestions.test.js",
    "test:solver-client": "rolldown tests/aiSolverClient.test.ts -p node -f esm -o .npm-cache/ai-solver-client-test.mjs && node .npm-cache/ai-solver-client-test.mjs",
    "test:persistence": "rolldown tests/questionAnswerCompletion.test.ts -p node -f esm -o .npm-cache/question-answer-persistence-test.mjs && node .npm-cache/question-answer-persistence-test.mjs",
    "test:deepseek": "node tests/deepseekClient.test.js",
    "test:proxy": "node tests/proxyConfig.test.js",
    "test:env": "node tests/envConfig.test.js",
    "diagnose:env": "node scripts/check-env.js"
  },
  "dependencies": {
    "dotenv": "^18.0.4",
    "mammoth": "1.13.0",
    "openai": "^7.25.0",
    "pdfjs-dist": "6.3.289",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-router-dom": "7.18.4",
    "xlsx": "0.18.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "^5.9.0",
    "vite": "8.3.1"
  }
}
